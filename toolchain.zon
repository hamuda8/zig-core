    .android_build_tools = "37.0.0",
    .android_platform = "android-36",
    // Debug signing key; created on first build. Keep it: changing it forces reinstalling the app.
    .debug_keystore = "C:\\Users\\tarek\\.android\\debug.keystore",
}
